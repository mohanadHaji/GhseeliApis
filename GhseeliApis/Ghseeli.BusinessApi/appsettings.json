{
  "ConnectionStrings": {
    "BusinessConnection": ""
  },
  "Application": {
    "Name": "Ghseeli Business API"
  },
  "BusinessJwtSettings": {
    "SecretKey": "",
    "Issuer": "Ghseeli.BusinessApi",
    "Audience": "Ghseeli.BusinessClients",
    "ExpirationMinutes": 60
  },
  "InternalServiceAuthentication": {
    "RequireHttps": true,
    "AllowInsecureHttpInDevelopment": false,
    "AllowedClockSkewSeconds": 120,
    "NonceLifetimeSeconds": 300,
    "IdempotencyLifetimeSeconds": 86400,
    "InProgressWaitMilliseconds": 5000,
    "InProgressPollMilliseconds": 50,
    "MaxRequestBodyBytes": 65536,
    "MaxStoredResponseBytes": 65536,
    "Services": []
  },
  "CustomerBookingStatusClient": {
    "BaseUrl": "",
    "ServiceId": "",
    "ActiveSecret": "",
    "RequireHttps": true,
    "AllowInsecureHttpInDevelopment": false,
    "TimeoutSeconds": 15,
    "DisableDeliveryInTesting": false
  },
  "BookingStatusOutbox": {
    "LeaseSeconds": 60,
    "MaxAttempts": 8,
    "BaseRetrySeconds": 2,
    "MaxRetrySeconds": 300,
    "PollIntervalMilliseconds": 5000,
    "FailureBackoffMilliseconds": 1000
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
