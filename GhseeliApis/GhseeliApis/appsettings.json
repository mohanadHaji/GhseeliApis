{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "YOUR_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS_LONG_FOR_SECURITY",
    "Issuer": "GhseeliApis",
    "Audience": "GhseeliApis",
    "ExpirationMinutes": 60
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID_HERE",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET_HERE"
    },
    "Facebook": {
      "AppId": "YOUR_FACEBOOK_APP_ID_HERE",
      "AppSecret": "YOUR_FACEBOOK_APP_SECRET_HERE"
    }
  },
  "CloudSql": {
    "Server": "localhost",
    "Port": "3306",
    "Database": "ghseeli_db",
    "UserId": "root",
    "Password": "",
    "InstanceConnectionName": ""
  },
  "// NOTE": "Never commit real passwords or secret keys. Use environment variables or User Secrets for sensitive data.",
  "// To set JWT secret via User Secrets": "dotnet user-secrets set JwtSettings:SecretKey your_secret_key",
  "// To set OAuth credentials via User Secrets": "dotnet user-secrets set Authentication:Google:ClientId your_client_id",
  "// To set OAuth credentials via User Secrets": "dotnet user-secrets set Authentication:Google:ClientSecret your_client_secret",
  "// To set OAuth credentials via User Secrets": "dotnet user-secrets set Authentication:Facebook:AppId your_app_id",
  "// To set OAuth credentials via User Secrets": "dotnet user-secrets set Authentication:Facebook:AppSecret your_app_secret",
  "// To set password via environment variable": "export CloudSql__Password=your_password",
  "// To use User Secrets in development": "dotnet user-secrets set CloudSql:Password your_password"
}
