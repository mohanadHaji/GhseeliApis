{
  "name": "Frontend API notes",
  "description": "Progressive live-local checks for vehicle/category presentation, favourites, reviews, banners, optional-device public access, and advisory availability. Requires disposable local databases and local-only fixture variables.",
  "sensitiveFields": [
    "authorization",
    "token",
    "x-device-token",
    "x-ghseeli-signature",
    "x-ghseeli-nonce",
    "secret",
    "email",
    "phone",
    "licensePlate"
  ],
  "setupVariables": {
    "runStamp": "{{gen:timestamp:yyyyMMddHHmmssfff}}",
    "vehicleImageUrl": "https://cdn.example.test/frontend-api-notes/vehicle.png",
    "categoryImageUrl": "https://cdn.example.test/frontend-api-notes/category.png",
    "bannerImageUrl": "https://cdn.example.test/frontend-api-notes/banner.png",
    "unknownId": "00000000-0000-0000-0000-000000000001",
    "invalidDeviceToken": "short-token",
    "reviewComment": "Frontend API notes review {{var:runStamp}}",
    "availabilityDate": "{{var:fixtureAvailabilityDate}}"
  },
  "scenarios": [
    {
      "id": "FAN-CONTRACT-SWAGGER-001",
      "planScenarioId": "FAN-CONTRACT-SWAGGER-001",
      "feature": "frontend-api-notes",
      "tags": ["contract", "swagger", "customer", "progressive"],
      "method": "GET",
      "url": "{{var:customerBaseUrl}}/swagger/v1/swagger.json",
      "headers": {"Accept": "application/json"},
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "json": [
          {"path": "$.paths['/api/v1/catalog/businesses'].get", "exists": true},
          {"path": "$.paths['/api/v1/catalog/businesses/{businessId}/favourite'].put", "exists": true},
          {"path": "$.paths['/api/v1/catalog/businesses/{businessId}/favourite'].delete", "exists": true},
          {"path": "$.paths['/api/v1/bookings/{bookingId}/review'].get", "exists": true},
          {"path": "$.paths['/api/v1/bookings/{bookingId}/review'].put", "exists": true},
          {"path": "$.paths['/api/v1/bookings/{bookingId}/review'].delete", "exists": true},
          {"path": "$.paths['/api/v1/catalog/businesses/{businessId}/reviews'].get", "exists": true},
          {"path": "$.paths['/api/v1/banners'].get", "exists": true},
          {"path": "$.paths['/api/v1/admin/banners'].get", "exists": true},
          {"path": "$.paths['/api/v1/admin/banners'].post", "exists": true},
          {"path": "$.paths['/api/v1/admin/banners/{id}'].put", "exists": true},
          {"path": "$.paths['/api/v1/admin/banners/{id}'].delete", "exists": true},
          {"path": "$.paths['/api/v1/catalog/businesses/availability-search'].post", "exists": true},
          {"path": "$.components.schemas.VehicleType.enum[0]", "equals": "Sedan"},
          {"path": "$.components.schemas.VehicleType.enum[1]", "equals": "Motorcycle"},
          {"path": "$.components.schemas.VehicleType.enum[2]", "equals": "Suv5Seater"},
          {"path": "$.components.schemas.VehicleType.enum[3]", "equals": "Suv7Seater"},
          {"path": "$.components.schemas.VehicleType.enum[4]", "equals": "Van7Seater"}
        ],
        "bodyNotContains": ["ConnectionString", "ActiveSecret", "Bearer ", "@example.com"]
      }
    },
    {
      "id": "FAN-CONTRACT-SWAGGER-002",
