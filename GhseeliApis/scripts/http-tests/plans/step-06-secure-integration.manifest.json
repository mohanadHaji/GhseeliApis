      },
      "jsonBody": {
        "nameAr": "{{var:branchNameAr}}",
        "addressAr": "الرياض",
        "latitude": 24.7136,
        "longitude": 46.6753
      },
      "expect": {
        "status": 201,
        "contentType": "application/json",
        "json": [
          {
            "path": "$.id",
            "exists": true
          },
          {
            "path": "$.nameAr",
            "equals": "{{var:branchNameAr}}"
          },
          {
            "path": "$.latitude",
            "equals": 24.7136
          },
          {
            "path": "$.longitude",
            "equals": 46.6753
          }
        ]
      },
      "extract": {
        "branchId": "$.id"
      }
    },
