        "branchId": "{{var:branchId}}",
        "nameAr": "{{var:offeringNameAr}}",
        "basePrice": 50,
        "durationMinutes": 60,
        "displayOrder": 0,
        "isActive": true
      },
      "expect": {
        "status": 201,
        "contentType": "application/json",
        "json": [
          {
            "path": "$.id",
            "exists": true
          },
          {
            "path": "$.categoryId",
            "equals": "{{var:categoryId}}"
          },
          {
            "path": "$.branchId",
            "equals": "{{var:branchId}}"
          },
          {
            "path": "$.nameAr",
            "equals": "{{var:offeringNameAr}}"
          },
          {
            "path": "$.basePrice",
            "equals": 50
          },
          {
            "path": "$.durationMinutes",
            "equals": 60
          }
        ]
      },
      "extract": {
