        "Accept": "application/json",
        "Content-Type": "application/json",
        "Authorization": "Bearer {{var:businessOwnerToken}}"
      },
      "jsonBody": {
        "nameAr": "{{var:addonGroupNameAr}}",
        "selectionType": "QuantityCounter",
        "isRequired": false,
        "minimumSelections": 0,
        "maximumSelections": 3,
        "displayOrder": 0,
        "isActive": true,
        "choices": [
          {
            "nameAr": "{{var:addonChoiceNameAr}}",
            "priceAdjustment": 10,
            "durationAdjustmentMinutes": 15,
            "defaultQuantity": 0,
            "displayOrder": 0,
            "isActive": true
          }
        ]
      },
      "expect": {
        "status": 201,
        "contentType": "application/json",
        "json": [
