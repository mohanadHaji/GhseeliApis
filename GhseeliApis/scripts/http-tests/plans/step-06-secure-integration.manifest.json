    {
      "id": "STEP6-INTERNAL-SNAPSHOT-SUCCESS-011",
      "feature": "step6",
      "tags": ["step6", "auth", "correlation", "contract"],
      "method": "GET",
      "url": "/api/v1/internal/catalog/snapshot?companyId={{var:companyId}}",
      "headers": {
        "Accept": "application/json",
        "X-Correlation-Id": "{{var:echoCorrelationId}}"
      },
      "internalAuth": {
        "serviceId": "{{var:internalServiceId}}",
        "secretEnv": "GHSEELI_HTTP_TEST_INTERNAL_ACTIVE_SECRET"
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "headers": {
          "X-Correlation-Id": {
            "equals": "{{var:echoCorrelationId}}"
          }
        },
        "json": [
          {
            "path": "$.company.id",
            "equals": "{{var:companyId}}"
          },
          {
            "path": "$.company.nameAr",
            "equals": "{{var:companyNameAr}}"
          },
          {
            "path": "$.categories[0].id",
            "equals": "{{var:categoryId}}"
          },
          {
            "path": "$.categories[0].offerings[0].id",
            "equals": "{{var:offeringId}}"
          },
          {
            "path": "$.categories[0].offerings[0].addonGroups[0].choices[0].id",
            "equals": "{{var:addonChoiceId}}"
          }
        ]
      },
      "extract": {
        "catalogVersion": "$.catalogVersion"
      }
    },
    {
      "id": "STEP6-INTERNAL-VALIDATE-SUCCESS-012",
      "feature": "step6",
      "tags": ["step6", "auth", "idempotency", "contract"],
      "method": "POST",
      "url": "/api/v1/internal/appointments/validate",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json",
        "X-Correlation-Id": "{{var:validateCorrelationId}}",
        "Idempotency-Key": "{{var:validateSuccessIdempotencyKey}}"
      },
      "internalAuth": {
        "serviceId": "{{var:internalServiceId}}",
        "secretEnv": "GHSEELI_HTTP_TEST_INTERNAL_ACTIVE_SECRET"
      },
      "jsonBody": {
        "branchId": "{{var:branchId}}",
        "offeringId": "{{var:offeringId}}",
        "selectedAddons": [
          {
            "addonChoiceId": "{{var:addonChoiceId}}",
            "quantity": 2
          }
        ],
        "requestedSlotStartUtc": "{{var:requestedSlotStartUtc}}",
        "customerLocation": {
          "latitude": 24.7136,
          "longitude": 46.6753
        },
        "expectedCatalogVersion": "{{var:catalogVersion}}",
        "currency": "ILS"
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "headers": {
          "X-Correlation-Id": {
            "equals": "{{var:validateCorrelationId}}"
          }
        },
        "json": [
          {
            "path": "$.valid",
            "equals": true
          },
          {
            "path": "$.catalogVersion",
            "equals": "{{var:catalogVersion}}"
          },
          {
            "path": "$.currency",
            "equals": "ILS"
          },
          {
            "path": "$.branchId",
            "equals": "{{var:branchId}}"
          },
          {
            "path": "$.offeringId",
            "equals": "{{var:offeringId}}"
          },
          {
            "path": "$.normalizedSelections[0].quantity",
            "equals": 2
          },
          {
            "path": "$.totalPrice",
            "equals": 70
          },
          {
            "path": "$.totalDurationMinutes",
            "equals": 90
          },
          {
            "path": "$.availability.isAvailable",
            "equals": true
          },
          {
            "path": "$.serviceArea.isWithinServiceArea",
            "equals": true
          }
        ]
      }
    },
    {
      "id": "STEP6-INTERNAL-MISSING-AUTH-013",
      "feature": "step6",
      "tags": ["step6", "auth", "contract"],
      "method": "GET",
      "url": "/api/v1/internal/catalog/snapshot?companyId={{var:companyId}}",
      "headers": {
        "Accept": "application/json",
        "X-Correlation-Id": "{{var:missingAuthCorrelationId}}"
      },
      "expect": {
        "status": 401,
        "contentType": "application/problem+json",
        "headers": {
          "X-Correlation-Id": {
            "equals": "{{var:missingAuthCorrelationId}}"
          }
        },
        "json": [
          {
            "path": "$.type",
            "exists": true
          },
          {
            "path": "$.detail",
            "exists": true
          },
          {
            "path": "$.missingHeaders[0]",
            "equals": "serviceId"
          },
          {
            "path": "$.missingHeaders[3]",
            "equals": "signature"
          }
        ],
        "errorCode": {
          "path": "$.code",
          "equals": "internal_auth_missing_header"
        }
      }
    },
