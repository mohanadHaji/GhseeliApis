          },
          {
            "path": "$.nameAr",
            "equals": "{{var:addonGroupNameAr}}"
          },
          {
            "path": "$.selectionType",
            "equals": "QuantityCounter"
          },
          {
            "path": "$.choices[0].id",
            "exists": true
          },
          {
            "path": "$.choices[0].nameAr",
            "equals": "{{var:addonChoiceNameAr}}"
          }
        ]
      },
      "extract": {
        "addonGroupId": "$.id",
        "addonChoiceId": "$.choices[0].id"
      }
    },
