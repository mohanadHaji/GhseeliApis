{
  "name": "Step 8 customer configuration",
  "sensitiveFields": [
    "token",
    "email",
    "phone"
  ],
  "setupVariables": {
    "runStamp": "{{gen:timestamp:yyyyMMddHHmmss}}",
    "installationId": "{{gen:guid}}",
    "unknownDeviceToken": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "malformedDeviceToken": "short-token",
    "invalidCorrelationId": "corr-step8-overlong-correlation-id-that-must-be-replaced-before-roundtrip-{{var:runStamp}}"
  },
  "scenarios": [
    {
      "id": "STEP8-HEALTH-001",
      "feature": "step8",
      "tags": ["step8", "smoke", "contract"],
      "method": "GET",
      "url": "/api/Health",
      "headers": {
        "Accept": "application/json"
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "json": [
          {
            "path": "$.status",
            "equals": "Healthy"
          }
        ]
      }
    },
    {
      "id": "STEP8-SWAGGER-002",
      "feature": "step8",
      "tags": ["step8", "contract", "docs"],
      "method": "GET",
      "url": "/swagger/v1/swagger.json",
      "headers": {
        "Accept": "application/json"
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "json": [
          {
            "path": "$.paths['/api/v1/configuration'].get",
            "exists": true
          },
          {
            "path": "$.paths['/api/v1/configuration'].get.parameters[0].name",
            "equals": "language"
          },
          {
            "path": "$.paths['/api/v1/configuration'].get.parameters[0].in",
            "equals": "query"
          },
          {
            "path": "$.paths['/api/v1/configuration'].get.parameters[1].name",
            "equals": "Accept-Language"
          },
          {
            "path": "$.paths['/api/v1/configuration'].get.parameters[1].in",
            "equals": "header"
          },
          {
            "path": "$.paths['/api/v1/configuration'].get.responses['200']",
            "exists": true
          },
          {
            "path": "$.paths['/api/v1/configuration'].get.responses['400']",
            "exists": true
          },
          {
            "path": "$.paths['/api/v1/configuration'].get.responses['401']",
            "exists": true
          },
          {
            "path": "$.paths['/api/v1/configuration'].get.responses['503']",
            "exists": true
          }
        ]
      }
    },
    {
      "id": "STEP8-DEVICE-ISSUE-003",
      "feature": "step8",
      "tags": ["step8", "setup", "security", "write"],
      "method": "POST",
      "url": "/api/v1/devices/register",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json"
      },
      "jsonBody": {
        "installationId": "{{var:installationId}}",
        "platform": "iOS",
        "appVersion": "1.0.0"
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "json": [
          {
            "path": "$.installationId",
            "equals": "{{var:installationId}}"
          },
          {
            "path": "$.platform",
            "equals": "iOS"
          },
          {
            "path": "$.token",
            "exists": true
          },
          {
            "path": "$.expiresAt",
            "exists": true
          }
        ]
      },
      "extract": {
        "issuedDeviceToken": "$.token"
      }
    },
    {
      "id": "STEP8-GET-DEFAULT-004",
      "feature": "step8",
      "tags": ["step8", "read", "localization", "contract"],
      "method": "GET",
      "url": "/api/v1/configuration",
      "headers": {
        "Accept": "application/json",
        "X-Device-Token": "{{var:issuedDeviceToken}}"
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "json": [
          {
            "path": "$.language",
            "equals": "ar"
          },
          {
            "path": "$.support.email",
            "exists": true
          },
          {
            "path": "$.support.phone",
            "exists": true
          },
          {
            "path": "$.display.name",
            "equals": "\u063a\u0633\u064a\u0644\u064a"
          },
          {
            "path": "$.legal.notice",
            "equals": "\u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u0625\u0646\u0643 \u062a\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629."
          },
          {
            "path": "$.legal.privacyPolicyUrl",
            "exists": true
          },
          {
            "path": "$.legal.termsOfServiceUrl",
            "exists": true
          },
          {
            "path": "$.maintenance.isEnabled",
            "equals": false
          }
        ]
      }
    },
