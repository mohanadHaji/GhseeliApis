    {
      "id": "STEP9-HEALTH-001",
      "feature": "step9",
      "tags": ["step9", "preseeded", "smoke", "contract"],
      "method": "GET",
      "url": "/api/health",
      "headers": {
        "Accept": "application/json"
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "headers": {
          "X-Correlation-Id": {
            "exists": true,
            "matches": "^[0-9a-f]{32}$"
          }
        },
        "json": [
          {
            "path": "$.status",
            "equals": "Healthy"
          },
          {
            "path": "$.service",
            "equals": "Ghseeli APIs"
          },
          {
            "path": "$.version",
            "equals": "v1"
          }
        ]
      }
    },
