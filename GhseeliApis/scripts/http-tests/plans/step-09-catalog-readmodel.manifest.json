          {
            "path": "$.paths['/api/v1/catalog/businesses'].get.responses['400']",
            "exists": true
          },
          {
            "path": "$.paths['/api/v1/catalog/businesses'].get.responses['401']",
            "exists": true
          },
          {
            "path": "$.paths['/api/v1/catalog/businesses'].get.responses['503']",
