      "expect": {
        "status": 200,
        "contentType": "application/json",
        "json": [
          {
            "path": "$.installationId",
            "equals": "{{var:installationId}}"
          },
          {
            "path": "$.platform",
            "equals": "iOS"
          },
          {
            "path": "$.token",
            "exists": true
          },
          {
            "path": "$.expiresAt",
            "exists": true
          }
        ]
      },
      "extract": {
        "issuedDeviceToken": "$.token"
