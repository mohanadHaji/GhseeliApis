  "scenarios": [
    {
      "id": "STEP10-SWAGGER-001",
      "feature": "step10",
      "tags": ["step10", "live", "contract", "docs"],
      "method": "GET",
      "url": "/swagger/v1/swagger.json",
      "headers": {
        "Accept": "application/json"
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "json": [
          {"path": "$.info.title", "equals": "Ghseeli APIs"},
          {"path": "$.paths['/api/v1/checkout/drafts'].post", "exists": true},
          {"path": "$.paths['/api/v1/checkout/drafts/{orderGuid}'].get", "exists": true},
          {"path": "$.paths['/api/v1/checkout/drafts/{orderGuid}'].put", "exists": true}
        ]
      }
    },
    {
      "id": "STEP10-DEVICE-ISSUE-002",
      "feature": "step10",
      "tags": ["step10", "live", "setup", "security"],
      "method": "POST",
      "url": "/api/v1/devices/register",
