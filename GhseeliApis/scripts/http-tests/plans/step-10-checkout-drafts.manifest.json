      "expect": {
        "status": 200,
        "contentType": "application/json",
        "json": [
          {"path": "$.installationId", "equals": "{{var:firstInstallationId}}"},
          {"path": "$.platform", "equals": "iOS"},
          {"path": "$.appVersion", "equals": "1.0.0"},
          {"path": "$.token", "exists": true},
          {"path": "$.expiresAt", "exists": true}
        ]
      },
      "extract": {
        "firstDeviceToken": "$.token"
      }
    },
