      },
      "jsonBody": {
        "businessSourceId": "{{var:businessSourceId}}",
        "branchSourceId": "{{var:branchSourceId}}",
        "requestedSlotStartUtc": "{{var:createSlotStartUtc}}",
        "quotedSubtotal": 0.01,
        "quotedTotal": 0.02,
        "vehicle": {
          "vehicleType": "Sedan",
          "licensePlate": "12-345-67",
          "make": "Toyota",
          "model": "Corolla",
          "color": "Blue",
          "quotedVehiclePrice": 0.03
        },
        "location": {
          "addressLine": "الشارع الرئيسي 10",
          "city": "حيفا",
          "area": "الكرمل",
          "latitude": 32.1,
          "longitude": 34.8,
          "quotedServiceFee": 0.04
        },
        "items": [
          {
            "offeringSourceId": "{{var:offeringSourceId}}",
            "quotedBasePrice": 0.05,
            "selections": []
          }
        ]
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "headers": {
          "Cache-Control": {
            "equals": "no-store"
          }
        },
        "json": [
          {"path": "$.language", "equals": "ar"},
          {"path": "$.expiresAt", "exists": true},
          {"path": "$.version", "equals": 1},
          {"path": "$.requiresReprice", "equals": true},
          {"path": "$.intent.businessSourceId", "equals": "{{var:businessSourceId}}"},
          {"path": "$.intent.branchSourceId", "equals": "{{var:branchSourceId}}"},
          {"path": "$.intent.catalogVersion", "exists": true},
          {"path": "$.intent.requestedSlotStartUtc", "matches": "^2026-08-24T10:00:00(?:Z|\\+00:00)$"},
          {"path": "$.intent.vehicle.vehicleType", "equals": "Sedan"},
          {"path": "$.intent.vehicle.licensePlate", "equals": "12-345-67"},
          {"path": "$.intent.vehicle.make", "equals": "Toyota"},
          {"path": "$.intent.vehicle.model", "equals": "Corolla"},
          {"path": "$.intent.vehicle.color", "equals": "Blue"},
          {"path": "$.intent.location.addressLine", "equals": "الشارع الرئيسي 10"},
          {"path": "$.intent.location.city", "equals": "حيفا"},
          {"path": "$.intent.location.area", "equals": "الكرمل"},
          {"path": "$.intent.location.latitude", "equals": 32.1},
          {"path": "$.intent.location.longitude", "equals": 34.8},
          {"path": "$.intent.items[0].offeringSourceId", "equals": "{{var:offeringSourceId}}"},
          {"path": "$.intent.items[0].selections[0]", "exists": false},
          {"path": "$.quotedTotal", "exists": false},
          {"path": "$.intent.quotedSubtotal", "exists": false}
        ]
      },
      "extract": {
        "createdOrderGuid": "$.orderGuid",
        "createdVersion": "$.version",
        "createdCatalogVersion": "$.intent.catalogVersion"
      }
    },
