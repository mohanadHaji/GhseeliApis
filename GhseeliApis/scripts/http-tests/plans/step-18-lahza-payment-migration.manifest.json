{
  "name": "Step 18 Lahza payment migration",
  "description": "Safe local HTTP coverage for the provider-neutral Lahza contract. Secrets and credentials are generated only in ignored local artifacts.",
  "sensitiveHeaders": [
    "authorization",
    "x-device-token",
    "x-lahza-signature",
    "idempotency-key"
  ],
  "scenarios": [
    {
      "id": "STEP18-LAHZA-CONTRACT-001",
      "planScenarioId": "STEP18-LAHZA-CONTRACT-001",
      "feature": "step18",
      "tags": ["step18", "configured", "contract"],
      "method": "GET",
      "url": "/swagger/v1/swagger.json",
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "json": [
          { "path": "$.components.schemas.CustomerPaymentResponse.properties.provider", "exists": true },
          { "path": "$.components.schemas.CustomerPaymentResponse.properties.checkoutUrl", "exists": true },
          { "path": "$.components.schemas.CustomerPaymentResponse.properties.providerReference", "exists": true },
          { "path": "$.components.schemas.CustomerPaymentResponse.properties.clientSecret", "exists": false },
          { "path": "$.components.schemas.CustomerPaymentResponse.properties.publishableKey", "exists": false },
          { "path": "$.components.schemas.CustomerPaymentResponse.properties.paymentIntentId", "exists": false },
          { "path": "$.components.schemas.CustomerPaymentResponse.properties.chargeId", "exists": false }
        ]
      }
    },
    {
      "id": "STEP18-LAHZA-SWAGGER-030",
      "planScenarioId": "STEP18-LAHZA-SWAGGER-030",
      "feature": "step18",
      "tags": ["step18", "configured", "contract"],
      "method": "GET",
      "url": "/swagger/v1/swagger.json",
      "expect": {
        "status": 200,
        "json": [
          { "path": "$.paths['/api/v1/payments/intents'].post", "exists": true },
          { "path": "$.paths['/api/v1/payments/{id}'].get", "exists": true },
          { "path": "$.paths['/api/v1/payments/{id}/verify'].post", "exists": true },
          { "path": "$.paths['/api/lahza/webhook'].post", "exists": true },
          { "path": "$.paths['/api/stripe/webhook']", "exists": false },
          { "path": "$.paths['/api/lahza/webhook'].post.security[0].LahzaSignature", "exists": true },
          { "path": "$.paths['/api/v1/payments/{id}/verify'].post.security[0].CustomerBearer", "exists": true }
        ]
      }
    },
    {
      "id": "STEP18-LAHZA-STRIPE-ROUTE-REMOVED",
      "planScenarioId": "STEP18-LAHZA-SWAGGER-030",
      "feature": "step18",
      "tags": ["step18", "configured", "route"],
      "method": "POST",
      "url": "/api/stripe/webhook",
      "headers": { "Content-Type": "application/json" },
      "jsonBody": {},
      "expect": {
        "status": 404,
        "bodyNotContains": ["Stripe-Signature", "clientSecret", "paymentIntentId", "sk_", "exception", "stack"]
      }
    },
    {
      "id": "STEP18-LAHZA-INIT-004",
      "planScenarioId": "STEP18-LAHZA-INIT-004",
      "feature": "step18",
      "tags": ["step18", "configured", "payment-create"],
      "method": "POST",
      "url": "/api/v1/payments/intents?language=ar",
      "headers": {
        "Authorization": "{{var:ownerAuthorization}}",
        "X-Device-Token": "{{var:ownerDeviceToken}}",
        "Idempotency-Key": "step18-primary",
        "Content-Type": "application/json"
      },
      "jsonBody": {
        "bookingId": "{{var:primaryBookingId}}",
        "method": "Card"
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "jsonPropertyCount": 11,
        "json": [
          { "path": "$.bookingId", "equals": "{{var:primaryBookingId}}" },
          { "path": "$.amount", "equals": 10.0 },
          { "path": "$.currency", "equals": "ILS" },
          { "path": "$.method", "equals": "Card" },
          { "path": "$.status", "equals": "Pending" },
          { "path": "$.provider", "equals": "Lahza" },
          { "path": "$.providerReference", "matches": "^GHSEELI-[A-F0-9]{32}$" },
          { "path": "$.checkoutUrl", "matches": "^https://checkout\\.lahza\\.test/" }
        ],
        "bodyNotContains": [
          "clientSecret", "publishableKey", "paymentIntentId", "chargeId",
          "Stripe", "sk_", "secret", "authorizationCode", "@example"
        ]
      },
      "extract": {
        "primaryPaymentId": "$.id",
        "primaryProviderReference": "$.providerReference",
        "primaryCheckoutUrl": "$.checkoutUrl"
      }
    },
    {
