        "email": "attacker@example.invalid"
      },
      "expect": {
        "status": 200,
        "json": [
          { "path": "$.bookingId", "equals": "{{var:secondaryBookingId}}" },
          { "path": "$.amount", "equals": 10.0 },
          { "path": "$.currency", "equals": "ILS" },
          { "path": "$.provider", "equals": "Lahza" },
          { "path": "$.status", "equals": "Pending" }
        ],
        "bodyNotContains": ["pi_forged", "attacker@example.invalid", "Stripe", "clientSecret"]
      },
      "extract": {
        "secondaryPaymentId": "$.id",
        "secondaryProviderReference": "$.providerReference"
      }
